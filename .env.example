# Copy to `.dev.vars` for local development (read by the Cloudflare Vite plugin)
# or set as environment variables on the hosting platform. Every value is optional;
# the defaults point at free community services with rate limits and no uptime
# guarantees, so a real deployment should replace at least the geocoder and router.

# Public URL of the deployment. Used for Open Graph images and the User-Agent
# that OpenStreetMap services require.
APP_URL=https://roamwise-guide.eklund-linus.chatgpt.site

# Language for geocoder results.
GEOCODER_LANGUAGE=sv

# Nominatim-compatible geocoder, e.g. a self-hosted instance or a paid provider
# exposing the same API.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Photon-compatible fallback geocoder.
PHOTON_URL=https://photon.komoot.io

# Overpass API interpreters, comma-separated, tried in order.
OVERPASS_URLS=https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Valhalla-compatible pedestrian router.
VALHALLA_URL=https://valhalla1.openstreetmap.de

# NYC Open Data restaurant inspection dataset (Socrata JSON endpoint).
NYC_OPEN_DATA_URL=https://data.cityofnewyork.us/resource/43nn-pn8j.json
