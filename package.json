{
  "name": "roamwise-guide",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vinext build",
    "build:sites": "bash scripts/build-verified.sh",
    "start": "vinext start",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --experimental-strip-types --import ./tests/register-ts.mjs --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{app,db,worker,build,tests}/**/*.{ts,tsx,mjs,css}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"{app,db,worker,build,tests}/**/*.{ts,tsx,mjs,css}\" \"*.{ts,mjs,json}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply site-creator-d1 --local --config wrangler.local.jsonc",
    "install:ci": "bash scripts/install-ci.sh"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Roamwise"
}
